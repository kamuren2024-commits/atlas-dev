{
  "name": "Salience_Atlas",
  "private": true,
  "version": "5.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:demo": "node scripts/start-demo.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "postinstall": "mkdir -p build/Release && ln -sf ../../node_modules/sqlite3/build/Release/node_sqlite3.node build/Release/node_sqlite3.node && ln -sf ../../node_modules/better-sqlite3/prebuilds/linux-x64.node build/Release/better_sqlite3.node || true",
    "lint": "tsc --noEmit",
    "test": "tsx backend/tests/run-tests.ts && node --import tsx --test backend/tests/server-config.test.ts backend/evaluation/eval-harness.test.ts",
    "test:agent-control-plane": "tsx backend/tests/agent-control-plane.test.ts",
    "test:logistics-security": "node --import tsx --test backend/tests/logistics-security.integration.test.ts",
    "test:architecture": "tsx backend/evaluation/legal-control-plane/phase4-control-plane.test.ts",
    "test:contracts": "tsx backend/evaluation/legal-control-plane/phase4-control-plane.test.ts",
    "eval": "tsx backend/evaluation/eval-harness.ts all",
    "eval:agents": "tsx backend/evaluation/eval-harness.ts agents",
    "eval:gateway": "tsx backend/evaluation/eval-harness.ts gateway",
    "eval:ontology": "tsx backend/evaluation/eval-harness.ts ontology",
    "eval:tools": "tsx backend/evaluation/eval-harness.ts tools",
    "eval:all": "tsx backend/evaluation/eval-harness.ts all",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name db01_init",
    "migrate:sqlite-to-pg": "node scripts/migrate_sqlite_to_postgres.js",
    "validate:db01": "node scripts/validate_db01_migration.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@google/genai": "^2.4.0",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/vite": "^4.1.14",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.0",
    "sqlite3": "^5.1.7",
    "three": "^0.185.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/google.maps": "^3.66.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.14.0",
    "@types/sqlite3": "^3.1.11",
    "@types/three": "^0.185.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "better-sqlite3": "^13.0.3",
    "esbuild": "^0.25.0",
    "json-schema": "^0.4.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
